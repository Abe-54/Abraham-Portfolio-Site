---
interface Props {
  index: string;
  kicker: string;
  title: string;
  align?: "left" | "center";
}

const { index, kicker, title, align = "left" } = Astro.props;
---

<div
  class:list={[
    "reveal flex flex-col gap-3",
    align === "center" && "items-center text-center",
  ]}
>
  <span class="hud flex items-center gap-2">
    <span aria-hidden="true">{index}</span>
    <span class="h-px w-6 bg-accent/50"></span>
    {kicker}
  </span>
  <h2 class="text-h2 font-semibold tracking-tight text-balance">{title}</h2>
</div>
