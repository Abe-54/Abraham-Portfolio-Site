---
import { site, socials } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-border px-6 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
    <div class="flex flex-col gap-1">
      <span class="font-pixel text-[0.7rem] text-accent">{site.initials}</span>
      <p class="text-sm text-muted-foreground">
        © {year} {site.name}. Built with Astro, TypeScript & Tailwind.
      </p>
    </div>

    <nav aria-label="Social" class="flex flex-wrap gap-4">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
