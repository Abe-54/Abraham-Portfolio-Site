---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import Timeline from "@/components/sections/Timeline.astro";
import Skills from "@/components/sections/Skills.astro";
import ProjectsSection from "@/components/sections/Projects.astro";
import Contact from "@/components/sections/Contact.astro";
import Footer from "@/components/Footer.astro";
import { work, projects } from "@/data/projects";
---

<Layout gameEffects>
  <Hero />
  <About />
  <Timeline />
  <Skills />
  <ProjectsSection
    id="work"
    index="04"
    command="ls ~/work"
    comment="shipping at NJDCA"
    title="What I'm building at NJDCA."
    items={work}
    variant="work"
  />
  <ProjectsSection
    id="projects"
    index="05"
    command="ls ~/projects"
    comment="things I build for fun"
    title="Side quests."
    items={projects}
    variant="projects"
  />
  <Contact />
  <Footer />
</Layout>
