{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": false
  },
  "include": [".astro/types.d.ts", "src", "*.config.mjs", "*.config.ts"],
  "exclude": ["dist", "legacy", "node_modules"]
}
