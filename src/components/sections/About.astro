---
import SectionHeading from "@/components/SectionHeading.astro";

const facts = [
  { k: "Based in", v: "Newark, NJ" },
  { k: "Focus", v: "Full-stack web + game dev" },
  { k: "Currently", v: "Building at NJDCA" },
  { k: "Off the clock", v: "Designing & playing games" },
];
---

<section id="about" class="px-6 py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
    <div class="flex flex-col gap-8">
      <SectionHeading index="01" kicker="About" title="Code with a bit of play." />

      <dl class="reveal grid grid-cols-2 gap-x-6 gap-y-5" style="--reveal-delay:120ms">
        {
          facts.map((f) => (
            <div class="flex flex-col gap-1">
              <dt class="hud text-muted-foreground/80">{f.k}</dt>
              <dd class="text-sm font-medium text-foreground">{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="reveal flex flex-col gap-5 text-pretty leading-relaxed text-muted-foreground" style="--reveal-delay:80ms">
      <p>
        I'm a <strong class="font-semibold text-foreground">full-stack software
        engineer</strong> who likes shipping software people actually use. I
        graduated from{" "}
        <strong class="font-semibold text-foreground">Bloomfield College of Montclair
        State University</strong> with a degree in Computer Science and Game
        Programming — so I tend to think about both the engineering and the
        experience.
      </p>
      <p>
        In 2024 I interned at <strong class="font-semibold text-foreground">NASA</strong>{" "}
        as a climate game developer, turning dense scientific concepts into a
        playable Unity experience for classrooms. Today I build and ship
        production web apps — internal tools and constituent-facing government
        applications — at the{" "}
        <strong class="font-semibold text-foreground">New Jersey Department of
        Community Affairs</strong> with Next.js, TypeScript, and PostgreSQL on AWS,
        owning features from implementation through deployment with an eye for
        clean, scalable code and clear UX.
      </p>
      <p>
        I build with AI in the loop. At NJDCA I shipped full-stack features for an
        AI-assisted document system using{" "}
        <strong class="font-semibold text-foreground">Retrieval-Augmented
        Generation (RAG)</strong>, and day to day I lean on{" "}
        <strong class="font-semibold text-foreground">Claude</strong> as a
        pair-programmer — scaffolding features, reviewing diffs, and pressure-testing
        approaches — alongside automated AI-assisted PR reviews. It lets me move
        quickly without lowering the bar on what ships.
      </p>
      <p>
        When I'm off the clock you'll usually find me designing or playing games,
        watching anime, or tinkering with small creative projects — the same
        curiosity that got me into this in the first place.
      </p>
    </div>
  </div>
</section>
