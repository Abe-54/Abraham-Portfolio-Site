---
import SectionHeading from "@/components/SectionHeading.astro";
import type { Project } from "@/data/projects";
import { ArrowUpRight } from "@lucide/astro";
import WindowControls from "@/components/WindowControls.astro";

interface Props {
  id: string;
  index: string;
  command: string;
  comment?: string;
  title: string;
  items: Project[];
  variant: "work" | "projects";
}

const { id, index, command, comment, title, items, variant } = Astro.props;

const kindLabel = {
  web: "web",
  game: "game",
  ai: "ai",
  infra: "infra",
  bot: "bot",
  app: "app",
} as const;

const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
---

<section id={id} class="px-4 py-20 sm:px-6 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <SectionHeading index={index} command={command} comment={comment} title={title} />

    {
      variant === "work" ? (
        <div class="mt-12 flex flex-col gap-8">
          {items.map((p, i) => (
            <article class="reveal win" style={`--reveal-delay:${i * 90}ms`}>
              <div class="win-bar">
                <WindowControls />
                <span class="win-title">
                  ~/work/{slug(p.title)}
                </span>
                <span class="kind">[{kindLabel[p.kind]}]</span>
              </div>

              <div class="pane">
                <p class="prompt-line">
                  <span class="tok-green">$</span> cat README.md
                </p>
                <h3 class="ptitle">{p.title}</h3>
                <p class="pmeta tok-muted">
                  {p.role} · {p.period}
                </p>
                <p class="pdesc prose-sans">{p.description}</p>

                {p.placeholder && (
                  <p class="okline">
                    <span class="tok-green">✓</span>{" "}
                    <span class="tok-muted">{p.placeholder.note.replace(/^✓\s*/, "")}</span>
                  </p>
                )}

                <p class="tags">
                  {p.tags.map((t) => (
                    <span class="tag">
                      <span class="tok-muted">#</span>
                      {t.replace(/\s+/g, "-").toLowerCase()}
                    </span>
                  ))}
                </p>

                {p.links.length > 0 && (
                  <div class="links">
                    {p.links.map((l) => (
                      <a
                        href={l.href}
                        target="_blank"
                        rel="noopener"
                        class="keycap linkbtn"
                      >
                        {l.label}
                        <ArrowUpRight class="size-4" />
                      </a>
                    ))}
                  </div>
                )}

              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-12 grid items-stretch gap-6 [grid-template-columns:repeat(auto-fit,minmax(20rem,1fr))]">
          {items.map((p, i) => (
            <article
              class="reveal win card"
              style={`--reveal-delay:${i * 90}ms`}
            >
              <div class="win-bar">
                <WindowControls />
                <span class="win-title">~/projects/{slug(p.title)}</span>
                <span class="kind">[{kindLabel[p.kind]}]</span>
              </div>

              <div class="media-slot">
              {p.image ? (
                <div class="viewport scanlines">
                  <img
                    src={p.image}
                    alt={`${p.title} — screenshot`}
                    width={p.imageSize?.width}
                    height={p.imageSize?.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="output">
                  <p>
                    <span class="tok-green">$</span> {p.placeholder?.line ?? p.title}
                  </p>
                  <p class="tok-muted">{p.placeholder?.note ?? "✓ shipped"}</p>
                </div>
              )}
              </div>

              <div class="pane">
                <div class="copy">
                <h3 class="ptitle sm">{p.title}</h3>
                <p class="pmeta tok-muted">
                  {p.role} · {p.period}
                </p>
                <p class="pdesc prose-sans">{p.blurb}</p>
                </div>

                <div class="card-foot">
                <p class="tags">
                  {p.tags.slice(0, 4).map((t) => (
                    <span class="tag">
                      <span class="tok-muted">#</span>
                      {t.replace(/\s+/g, "-").toLowerCase()}
                    </span>
                  ))}
                </p>

                {p.links.length > 0 && (
                  <div class="links">
                    {p.links.map((l) => (
                      <a
                        href={l.href}
                        target="_blank"
                        rel="noopener"
                        class="keycap linkbtn"
                      >
                        {l.label}
                        <ArrowUpRight class="size-4" />
                      </a>
                    ))}
                  </div>
                )}
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .kind {
    margin-left: auto;
    font-size: 0.72rem;
    color: var(--accent);
    flex-shrink: 0;
  }

  .card {
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
  }
  .card .win-body {
    flex: 1;
  }
  .card .win-body-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pane {
    padding: clamp(1.2rem, 3vw, 1.9rem);
  }
  .card .pane {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card .copy {
    min-height: 0;
  }
  .card-foot {
    margin-top: auto;
    padding-top: 1rem;
  }

  .prompt-line {
    color: var(--muted-foreground);
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
  }
  .ptitle {
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .ptitle.sm {
    font-size: 1.2rem;
  }
  .pmeta {
    margin-top: 0.3rem;
    font-size: 0.82rem;
  }
  .pdesc {
    margin-top: 0.85rem;
    max-width: 64ch;
    color: var(--muted-foreground);
  }
  .okline {
    margin-top: 0.9rem;
    font-size: 0.85rem;
  }
  .tags {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
  }
  .card .tags {
    margin-top: 0;
  }
  .tag {
    color: var(--term-cyan);
    font-size: 0.78rem;
  }
  .links {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .linkbtn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.4rem;
    padding: 0 0.95rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--secondary);
    color: var(--foreground);
    font-size: 0.82rem;
    font-weight: 500;
  }
  .linkbtn:hover {
    border-color: color-mix(in oklch, var(--primary) 50%, var(--border));
  }

  /* project card media */
  .media-slot {
    height: clamp(9.5rem, 15vw, 11.5rem);
    flex: 0 0 auto;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .viewport {
    position: relative;
    height: 100%;
    overflow: hidden;
    background: var(--surface);
  }
  .viewport img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .output {
    height: 100%;
    padding: 1.5rem 1.25rem;
    background:
      radial-gradient(
        90% 80% at 15% 0%,
        color-mix(in oklch, var(--primary) 14%, transparent),
        transparent 70%
      ),
      var(--surface);
    font-size: 0.9rem;
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
