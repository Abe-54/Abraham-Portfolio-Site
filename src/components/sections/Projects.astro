---
import SectionHeading from "@/components/SectionHeading.astro";
import type { Project } from "@/data/projects";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  id: string;
  index: string;
  kicker: string;
  title: string;
  items: Project[];
}

const { id, index, kicker, title, items } = Astro.props;

const kindLabel = {
  web: "Web App",
  game: "Game",
  ai: "AI Platform",
  infra: "Cloud / Infra",
  bot: "Discord Bot",
  app: "Mobile App",
} as const;
---

<section id={id} class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHeading index={index} kicker={kicker} title={title} />

    <div class="mt-16 flex flex-col gap-20">
      {
        items.map((p, i) => (
          <article
            class:list={[
              "reveal grid items-center gap-8 md:grid-cols-2 md:gap-12",
              i % 2 === 1 && "md:[&>.media]:order-2",
            ]}
          >
            <div class="media">
              <div class="frame scanlines" data-kind={p.kind}>
                {p.image ? (
                  <img
                    src={p.image}
                    alt={`${p.title} — screenshot`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="placeholder">
                    <span class="hud">{p.tags[0]}</span>
                    <code class="cmd">{p.placeholder?.line ?? p.title}</code>
                    <span class="ok">{p.placeholder?.note ?? "✓ shipped"}</span>
                  </div>
                )}
              </div>
            </div>

            <div class="flex flex-col items-start gap-3">
              <span class="hud">{kindLabel[p.kind]}</span>
              <h3 class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
                {p.title}
              </h3>
              <p class="text-sm font-medium text-muted-foreground">
                {p.role} · {p.period}
              </p>
              <p class="max-w-[55ch] text-pretty text-muted-foreground">
                {p.description}
              </p>

              <ul class="mt-1 flex flex-wrap gap-2">
                {p.tags.map((t) => (
                  <li class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">
                    {t}
                  </li>
                ))}
              </ul>

              {p.links.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-3">
                  {p.links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener"
                      class="keycap inline-flex h-10 items-center gap-1.5 rounded-md border border-border bg-card/50 px-4 text-sm font-medium text-foreground transition-colors hover:bg-secondary"
                    >
                      {l.label}
                      <ArrowUpRight class="size-4" />
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 24px 50px -28px oklch(0 0 0 / 0.45);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.85rem;
    padding: 2rem;
    background:
      radial-gradient(
        80% 70% at 20% 0%,
        color-mix(in oklch, var(--primary) 18%, transparent),
        transparent 70%
      ),
      var(--surface);
  }
  .placeholder .cmd {
    font-family: var(--font-pixel);
    font-size: clamp(1rem, 3.5vw, 1.6rem);
    color: var(--foreground);
  }
  .placeholder .ok {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    color: var(--accent);
  }
</style>
