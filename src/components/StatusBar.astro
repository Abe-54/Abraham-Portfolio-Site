---
import { navLinks, site } from "@/data/site";
---

<div class="statusbar" role="group" aria-label="Page status">
  <div class="left">
    <span class="mode">NORMAL</span>
    <span class="seg path" aria-live="polite"><span class="tok-green">~/</span><span id="sb-path">home</span></span>
  </div>
  <div class="right">
    <span class="seg branch tabular" aria-hidden="true"
      ><span class="tok-amber">main</span> <span id="sb-progress">0%</span></span
    >
    <span class="seg hide-xs">{site.location}</span>
    <span class="seg clock tabular" id="sb-clock" aria-hidden="true">--:--:--</span>
  </div>
</div>

<script
  is:inline
  define:vars={{ ids: navLinks.map((l) => l.id) }}
>
  // live clock
  const clock = document.getElementById("sb-clock");
  const tick = () => {
    if (!clock) return;
    clock.textContent = new Date().toLocaleTimeString("en-US", {
      hour12: false,
    });
  };
  tick();
  setInterval(tick, 1000);

  // current section -> path label
  const pathEl = document.getElementById("sb-path");
  const sections = ids
    .map((id) => document.getElementById(id))
    .filter(Boolean);

  if (pathEl && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) pathEl.textContent = visible.target.id;
      },
      { rootMargin: "-20% 0px -60% 0px", threshold: [0, 0.25, 0.5, 1] }
    );
    sections.forEach((s) => io.observe(s));
  }

  // scroll progress
  const progress = document.getElementById("sb-progress");
  if (progress) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const pct = max > 0 ? Math.round((h.scrollTop / max) * 100) : 0;
      progress.textContent = pct + "%";
    };
    update();
    window.addEventListener(
      "scroll",
      () => {
        if (!raf) raf = requestAnimationFrame(update);
      },
      { passive: true }
    );
  }
</script>

<style>
  .statusbar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    height: var(--statusbar-h);
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--muted-foreground);
    background: var(--titlebar);
    border-top: 1px solid var(--border);
    backdrop-filter: blur(8px);
    user-select: none;
  }
  .left,
  .right {
    display: flex;
    align-items: stretch;
  }
  .seg {
    display: inline-flex;
    align-items: center;
    padding: 0 0.7rem;
    border-inline: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    border-block: 0;
  }
  .left .seg {
    border-left: 0;
  }
  .right .seg {
    border-right: 0;
  }
  .mode {
    display: inline-flex;
    align-items: center;
    padding: 0 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--primary-foreground);
    background: var(--primary);
  }
  .clock {
    color: var(--foreground);
  }
  @media (max-width: 480px) {
    .hide-xs {
      display: none;
    }
  }
</style>
