---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/mona-sans";
import "@fontsource/silkscreen";
import "@/styles/global.css";
import Nav from "@/components/Nav.tsx";
import StatusBar from "@/components/StatusBar.astro";
import Backdrop from "@/components/Backdrop.astro";
import GameClickEffects from "@/components/GameClickEffects.tsx";
import { site } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  gameEffects?: boolean;
}

const {
  title = `${site.name} — ${site.role}`,
  description = site.description,
} = Astro.props;

const gameEffects = Astro.props.gameEffects ?? false;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/abraham_professional.jpg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content="/abraham_professional.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* No-flash theme: dark-first, honor stored preference */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const isDark = stored ? stored === "dark" : true;
          document.documentElement.classList.toggle("dark", isDark);
        } catch {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body>
    <Backdrop />
    <Nav client:load />
    {gameEffects && <GameClickEffects client:load />}

    <main id="top">
      <slot />
    </main>

    <StatusBar />

    <script>
      // Scroll-reveal: reveal elements as they enter the viewport.
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (prefersReduced || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.15 }
        );
        items.forEach((el) => io.observe(el));
      }

      // Give mac-style window controls a small, non-destructive response.
      const windowActions = ["close", "minimize", "expand"] as const;
      const actionLabels = {
        close: "Close preview",
        minimize: "Minimize preview",
        expand: "Expand preview",
      };
      const windowMotionMs = 260;
      const windowAnimations = new WeakMap<HTMLElement, Animation>();
      const setWindowMotionVars = (
        win: HTMLElement,
        mode: "minimize" | "restore" = "minimize"
      ) => {
        const bar = win.querySelector<HTMLElement>(":scope > .win-bar");
        const currentHeight = win.getBoundingClientRect().height;
        const barHeight = bar?.getBoundingClientRect().height ?? 36;
        const savedRestoredHeight = Number.parseFloat(
          win.style.getPropertyValue("--win-restored-height")
        );
        const inlineHeight = Number.parseFloat(win.style.height);
        const shouldUseSavedHeight =
          mode === "restore" &&
          Number.isFinite(savedRestoredHeight) &&
          savedRestoredHeight > barHeight;
        const restoredHeight = shouldUseSavedHeight
          ? savedRestoredHeight
          : Number.isFinite(inlineHeight) && inlineHeight > barHeight
            ? inlineHeight
            : Math.max(win.scrollHeight, currentHeight, barHeight);

        win.style.setProperty("--win-start-height", `${currentHeight}px`);
        win.style.setProperty("--win-bar-height", `${barHeight}px`);
        win.style.setProperty("--win-restored-height", `${restoredHeight}px`);
      };
      const cssNumber = (win: HTMLElement, name: string, fallback: number) => {
        const value = Number.parseFloat(win.style.getPropertyValue(name));
        return Number.isFinite(value) ? value : fallback;
      };
      const tweenWindowHeight = (
        win: HTMLElement,
        from: number,
        to: number,
        onFinish: () => void
      ) => {
        windowAnimations.get(win)?.cancel();
        win.style.height = `${from}px`;
        win.style.maxHeight = `${from}px`;

        const animation = win.animate(
          [
            { height: `${from}px`, maxHeight: `${from}px` },
            { height: `${to}px`, maxHeight: `${to}px` },
          ],
          {
            duration: windowMotionMs,
            easing: "cubic-bezier(0.2, 0.8, 0.2, 1)",
            fill: "forwards",
          }
        );

        windowAnimations.set(win, animation);
        animation.onfinish = () => {
          if (windowAnimations.get(win) !== animation) return;
          windowAnimations.delete(win);
          win.style.height = `${to}px`;
          win.style.maxHeight = `${to}px`;
          onFinish();
        };
      };
      const restoreWindow = (win: HTMLElement) => {
        setWindowMotionVars(win, "restore");
        const from = cssNumber(win, "--win-bar-height", win.getBoundingClientRect().height);
        const to = cssNumber(win, "--win-restored-height", win.scrollHeight);

        win.classList.add("win-is-restoring");
        win.classList.remove("win-is-minimized");
        tweenWindowHeight(win, from, to, () => {
          win.classList.remove("win-is-restoring");
          win.style.height = "";
          win.style.maxHeight = "";
          win.style.removeProperty("--win-start-height");
          win.style.removeProperty("--win-restored-height");
          window.dispatchEvent(new Event("resize"));
        });
      };

      const windows = Array.from(document.querySelectorAll<HTMLElement>(".win"));
      windows.forEach((win) => {
        const existingBody = win.querySelector<HTMLElement>(":scope > .win-body");
        if (existingBody) {
          if (!existingBody.querySelector(":scope > .win-body-inner")) {
            const inner = document.createElement("div");
            inner.className = "win-body-inner";

            let node = existingBody.firstChild;
            while (node) {
              const next = node.nextSibling;
              inner.appendChild(node);
              node = next;
            }

            existingBody.appendChild(inner);
          }
          return;
        }

        const bar = win.querySelector(":scope > .win-bar");
        if (!bar) return;

        const body = document.createElement("div");
        body.className = "win-body";
        const inner = document.createElement("div");
        inner.className = "win-body-inner";

        let node = bar.nextSibling;
        while (node) {
          const next = node.nextSibling;
          inner.appendChild(node);
          node = next;
        }

        body.appendChild(inner);
        win.appendChild(body);
      });

      document.querySelectorAll<HTMLElement>(".win .dots").forEach((dots) => {
        dots.querySelectorAll<HTMLElement>("i").forEach((dot, index) => {
          const action = windowActions[index];
          if (!action) return;

          dot.tabIndex = 0;
          dot.setAttribute("role", "button");
          dot.setAttribute("aria-label", actionLabels[action]);
          dot.setAttribute("title", actionLabels[action]);

          const trigger = () => {
            const win = dot.closest<HTMLElement>(".win");
            if (!win || prefersReduced) return;

            const className = `win-${action}`;
            win.classList.add("win-interacted");

            if (action === "minimize") {
              if (win.classList.contains("win-is-minimized")) {
                restoreWindow(win);
                return;
              }

              setWindowMotionVars(win);
              const startHeight = cssNumber(
                win,
                "--win-start-height",
                win.getBoundingClientRect().height
              );
              const barHeight = cssNumber(win, "--win-bar-height", 36);
              win.classList.remove(className);
              void win.offsetWidth;
              win.classList.add(className);
              tweenWindowHeight(win, startHeight, barHeight, () => {
                win.classList.add("win-is-minimized");
                win.classList.remove(className);
                window.dispatchEvent(new Event("resize"));
              });
              return;
            }

            if (action === "expand") {
              if (win.classList.contains("win-is-minimized")) {
                restoreWindow(win);
                return;
              }
              win.classList.remove("win-is-minimized");
              window.dispatchEvent(new Event("resize"));
            }

            if (action === "close") {
              if (win.classList.contains("win-is-minimized")) {
                restoreWindow(win);
                return;
              }
              win.classList.remove("win-is-minimized");
              window.dispatchEvent(new Event("resize"));
            }

            win.classList.remove(className);
            void win.offsetWidth;
            win.classList.add(className);
            window.setTimeout(() => {
              win.classList.remove(className);
              win.classList.remove("win-is-restoring");
              window.dispatchEvent(new Event("resize"));
            }, windowMotionMs);
          };

          dot.addEventListener("pointerdown", (event) => {
            event.preventDefault();
            event.stopPropagation();
            trigger();
          });

          dot.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();
          });

          dot.addEventListener("keydown", (event) => {
            if (event.key !== "Enter" && event.key !== " ") return;
            event.preventDefault();
            trigger();
          });
        });
      });

      // V3 interactive terminals: native event handling so command entry does
      // not depend on framework hydration.
      const terminalEmail = "a.rubio1224@gmail.com";
      const terminalSocials = {
        github: "https://github.com/abe-54",
        linkedin: "https://www.linkedin.com/in/abraham-rubio/",
        itch: "https://abe-54.itch.io/",
      };
      const terminalAliases: Record<string, string> = {
        "?": "help",
        h: "help",
        cls: "clear",
        dir: "ls",
        "cd /": "cd home",
        "cd ~": "cd home",
        "cd ..": "cd home",
        connect: "contact",
      };
      const terminalHistory = new WeakMap<HTMLElement, string[]>();
      const terminalHistoryIndex = new WeakMap<HTMLElement, number>();

      const terminalPromptPath = (scope: string) =>
        `~/${scope === "home" ? "" : scope}`;

      const terminalAppend = (
        terminal: HTMLElement,
        kind: "input" | "output",
        lines: string | string[]
      ) => {
        const log = terminal.querySelector<HTMLElement>("[data-terminal-log]");
        if (!log) return;
        const scope = terminal.dataset.scope ?? "home";
        const values = Array.isArray(lines) ? lines : [lines];

        if (kind === "input") {
          const p = document.createElement("p");
          p.className = "interactive-terminal-line";
          p.innerHTML = `<span class="tok-green">abraham@portfolio</span><span class="tok-muted">:</span><span class="tok-blue">${terminalPromptPath(scope)}</span><span class="tok-green"> $ </span>`;
          p.append(document.createTextNode(values[0] ?? ""));
          log.append(p);
        } else {
          const group = document.createElement("div");
          group.className = "interactive-terminal-output";
          values.forEach((line) => {
            const p = document.createElement("p");
            p.textContent = line;
            group.append(p);
          });
          log.append(group);
        }

        log.scrollTop = log.scrollHeight;
      };

      const terminalOpen = (url: string, label: string) => {
        window.open(url, "_blank", "noopener,noreferrer");
        return [`opened ${label}`];
      };

      const terminalGo = (id: string) => {
        const target = document.getElementById(id);
        if (!target) return [`section not found: ${id}`];
        target.scrollIntoView({
          behavior: prefersReduced ? "auto" : "smooth",
          block: "start",
        });
        history.replaceState(null, "", `#${id}`);
        return [`jumped to ~/${id}`];
      };

      const terminalRun = async (scope: string, raw: string) => {
        const normalized = raw.trim().toLowerCase().replace(/\s+/g, " ");
        const command = terminalAliases[normalized] ?? normalized;
        const cdMatch = command.match(/^cd\s+(.+)$/);
        const grepMatch = command.match(/^grep\s+(.+)$/);
        const openMatch = command.match(/^open\s+(.+)$/);

        if (!command) return [];
        if (command === "clear") return "clear";
        if (command === "help") {
          return [
            "commands: help, clear, whoami, intro, neofetch, stack, tree, ls",
            "nav: cd home/about/timeline/skills/work/projects/contact",
            "actions: open resume/github/linkedin/itch, copy email, email",
          ];
        }
        if (cdMatch) {
          const id = cdMatch[1].replace(/^~\//, "").replace(/^\//, "");
          const known = id === "" ? "home" : id;
          if (
            ["home", "about", "timeline", "skills", "work", "projects", "contact"].includes(
              known
            )
          ) {
            return terminalGo(known);
          }
          return [`unknown directory: ${cdMatch[1]}`];
        }
        if (command === "whoami") {
          return [
            "Abraham Rubio - Full-Stack Software Engineer",
            "NJDCA by day, small games and creative code by night.",
          ];
        }
        if (command === "intro" || command === "cat intro.txt") {
          return [
            "I build production web apps with Next.js, TypeScript, PostgreSQL, and AWS.",
            "I care about accessible UI, useful systems, and software that feels good to use.",
          ];
        }
        if (command === "neofetch") {
          return [
            "role       Full-Stack Software Engineer",
            "company    NJ Dept. of Community Affairs",
            "education  B.S. Computer Science & Game Programming",
            "focus      full-stack web + indie games",
          ];
        }
        if (command === "stack" || command === "tree") {
          return [
            "frontend/ Next.js, TypeScript, Tailwind, shadcn/ui",
            "backend/  PostgreSQL, REST APIs, authentication",
            "cloud/    AWS, deployment workflows",
            "games/    Unity, C#, gameplay tools",
            "ai/       RAG systems, document workflows",
          ];
        }
        if (grepMatch) {
          const matches: Record<string, string[]> = {
            ai: ["RAG systems", "AI-assisted document workflows", "Google Gemini"],
            game: ["Unity", "C#", "Game Design", "Editor Tools", "Market Dash"],
            aws: ["AWS", "deployment workflows", "production web apps"],
          };
          return matches[grepMatch[1]] ?? [`no matches for "${grepMatch[1]}"`];
        }
        if (command === "ls") {
          if (scope === "projects") {
            return ["schedule-reader", "market-dash", "service-journal"];
          }
          if (scope === "work") return ["dca-ai-assistant", "nj-eviction-guide"];
          return [
            "about",
            "timeline",
            "skills",
            "work",
            "projects",
            "contact",
            "resume.pdf",
          ];
        }
        if (command === "cat dca-ai-assistant") {
          return [
            "Internal AI chat tool using approved document retrieval, RAG, RBAC, OTP auth, ingestion, and admin approval workflows.",
          ];
        }
        if (command === "cat nj-eviction-guide") {
          return [
            "Next.js rewrite of a constituent-facing guide with accessibility-first practices.",
          ];
        }
        if (command === "play market-dash") {
          return terminalOpen("https://abe-54.itch.io/market-dash", "Market Dash");
        }
        if (command === "source schedule-reader") {
          return terminalOpen(
            "https://github.com/Abe-54/ScheduleDiscordBot",
            "Schedule Reader source"
          );
        }
        if (command === "source service-journal") {
          return terminalOpen(
            "https://github.com/Abe-54/Service-Journal-App",
            "Service Journal source"
          );
        }
        if (command === "email") return [terminalEmail];
        if (command === "copy email") {
          try {
            await navigator.clipboard.writeText(terminalEmail);
            return ["email copied to clipboard"];
          } catch {
            return [`clipboard unavailable - ${terminalEmail}`];
          }
        }
        if (openMatch?.[1] === "resume" || command === "resume") {
          return terminalOpen("/resume.pdf", "resume.pdf");
        }
        if (openMatch?.[1] === "github" || command === "github") {
          return terminalOpen(terminalSocials.github, "GitHub");
        }
        if (openMatch?.[1] === "linkedin" || command === "linkedin") {
          return terminalOpen(terminalSocials.linkedin, "LinkedIn");
        }
        if (openMatch?.[1] === "itch" || command === "itch") {
          return terminalOpen(terminalSocials.itch, "itch.io");
        }
        if (["home", "about", "timeline", "skills", "work", "projects", "contact"].includes(command)) {
          return terminalGo(command);
        }

        return [`command not found: ${raw}`, "type help for available commands"];
      };

      document.addEventListener(
        "click",
        (event) => {
          const terminal = (event.target as Element | null)?.closest<HTMLElement>(
            "[data-terminal]"
          );
          terminal?.querySelector<HTMLInputElement>("[data-terminal-input]")?.focus();
        },
        true
      );

      document.addEventListener(
        "keydown",
        async (event) => {
          const input = event.target as HTMLInputElement | null;
          if (!input?.matches("[data-terminal-input]")) return;

          const terminal = input.closest<HTMLElement>("[data-terminal]");
          if (!terminal) return;

          if (event.key === "ArrowUp" || event.key === "ArrowDown") {
            event.preventDefault();
            const historyItems = terminalHistory.get(terminal) ?? [];
            if (!historyItems.length) return;
            const current = terminalHistoryIndex.get(terminal) ?? historyItems.length;
            const next =
              event.key === "ArrowUp"
                ? Math.max(0, current - 1)
                : Math.min(historyItems.length, current + 1);
            terminalHistoryIndex.set(terminal, next);
            input.value = historyItems[next] ?? "";
            return;
          }

          if (event.key !== "Enter") return;
          event.preventDefault();
          event.stopPropagation();

          const raw = input.value.trim();
          if (!raw) return;
          input.value = "";
          terminalAppend(terminal, "input", raw);

          const historyItems = [...(terminalHistory.get(terminal) ?? []), raw].slice(-16);
          terminalHistory.set(terminal, historyItems);
          terminalHistoryIndex.set(terminal, historyItems.length);

          const result = await terminalRun(terminal.dataset.scope ?? "home", raw);
          if (result === "clear") {
            terminal.querySelector<HTMLElement>("[data-terminal-log]")?.replaceChildren();
            return;
          }
          if (result.length) terminalAppend(terminal, "output", result);
        },
        true
      );
    </script>

    <style>
      main {
        position: relative;
        z-index: 1;
        isolation: isolate;
        padding-top: var(--topbar-h);
        padding-bottom: var(--statusbar-h);
      }

      :global(.game-click-effects) {
        position: fixed;
        inset: 0;
        z-index: 80;
        pointer-events: none;
        overflow: hidden;
      }

      :global(.game-click-particle) {
        position: fixed;
        display: block;
        border-radius: 1px;
        translate: -50% -50%;
        animation: game-particle-pop 620ms cubic-bezier(0.16, 1, 0.3, 1)
          forwards;
        animation-delay: var(--delay);
        will-change: transform, opacity;
      }

      @keyframes game-particle-pop {
        0% {
          opacity: 0;
          transform: scale(0.7) translate(0, 0) rotate(0);
        }
        12% {
          opacity: 0.9;
        }
        100% {
          opacity: 0;
          transform: scale(0.2) translate(var(--dx), var(--dy))
            rotate(var(--rot));
        }
      }
    </style>
  </body>
</html>
