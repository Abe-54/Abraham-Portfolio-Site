---
// Global animated backdrop: drifting aurora + faint grid.
// Lives behind all content (fixed, pointer-events:none). Brand blue + amber,
// kept whisper-subtle so it never competes with the foreground.
---

<div class="backdrop" aria-hidden="true">
  <div class="grid"></div>
  <div class="aurora a1"></div>
  <div class="aurora a2"></div>
  <div class="aurora a3"></div>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* faint engineering grid that slowly breathes downward */
  .grid {
    position: absolute;
    inset: -4px;
    background-image:
      linear-gradient(
        to right,
        color-mix(in oklch, var(--foreground) 7%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklch, var(--foreground) 7%, transparent) 1px,
        transparent 1px
      );
    background-size: 54px 54px;
    mask-image: radial-gradient(125% 100% at 50% 0%, black 50%, transparent 100%);
    -webkit-mask-image: radial-gradient(
      125% 100% at 50% 0%,
      black 50%,
      transparent 100%
    );
    opacity: 0.7;
    animation: gridDrift 24s linear infinite;
  }

  .aurora {
    position: absolute;
    width: 46rem;
    height: 46rem;
    border-radius: 999px;
    filter: blur(90px);
    will-change: transform;
  }
  .a1 {
    top: -18rem;
    left: -12rem;
    opacity: 0.5;
    background: radial-gradient(
      circle at center,
      color-mix(in oklch, var(--primary) 60%, transparent),
      transparent 65%
    );
    animation: drift1 26s ease-in-out infinite;
  }
  .a2 {
    bottom: -20rem;
    right: -14rem;
    opacity: 0.42;
    background: radial-gradient(
      circle at center,
      color-mix(in oklch, var(--accent) 48%, transparent),
      transparent 65%
    );
    animation: drift2 32s ease-in-out infinite;
  }
  .a3 {
    top: 38%;
    left: 46%;
    width: 32rem;
    height: 32rem;
    opacity: 0.3;
    background: radial-gradient(
      circle at center,
      color-mix(in oklch, var(--primary) 42%, transparent),
      transparent 62%
    );
    animation: drift3 38s ease-in-out infinite;
  }

  @keyframes gridDrift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(54px);
    }
  }
  @keyframes drift1 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(7rem, 5rem) scale(1.12);
    }
  }
  @keyframes drift2 {
    0%,
    100% {
      transform: translate(0, 0) scale(1.04);
    }
    50% {
      transform: translate(-6rem, -4rem) scale(0.94);
    }
  }
  @keyframes drift3 {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      transform: translate(-58%, -42%) scale(1.1);
    }
  }

  /* whisper-subtle on light backgrounds */
  :global(:root:not(.dark)) .a1 {
    opacity: 0.26;
  }
  :global(:root:not(.dark)) .a2 {
    opacity: 0.22;
  }
  :global(:root:not(.dark)) .a3 {
    opacity: 0.16;
  }

  @media (prefers-reduced-motion: reduce) {
    .grid,
    .aurora {
      animation: none;
    }
  }
</style>
